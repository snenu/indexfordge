SOSOVALUE_API_KEY=SOSO_xxx
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# Keep false by default to stay comfortably under the documented 20/minute
# SoSoValue key limit. The app still composes indexes without project info.
SOSOVALUE_ENABLE_PROJECT_INFO=false

# Optional for OpenAI-powered weights. Without it, IndexForge uses the
# built-in SoSoValue market-signal composer so the app still works,
# including for China browser users that cannot reach OpenAI directly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional SSI / SoDEX submit credentials.
SSI_PROTOCOL_KEY=
SODEX_SPOT_ENDPOINT=https://testnet-gw.sodex.dev/api/v1/spot
SODEX_ACCOUNT_ID=
SODEX_API_KEY_NAME=
SODEX_API_PRIVATE_KEY=
